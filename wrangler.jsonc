{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-r2pan",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  "observability": { "enabled": true },

  // ═══════════════ 管理员邮箱验证码登录 ═══════════════
  // 需要同时配置 secret RESEND_API_KEY 才会生效（登录页才显示邮箱登录入口）。

  // 保留原有的 workers.dev 测试域名（不加这一行，部署后会被默认关闭）
  "workers_dev": true,

  "routes": [
    { "pattern": "pan.lovlin.cn", "custom_domain": true }
  ],

  // ═══════════════ 基础设施资源绑定（自动查找/创建） ═══════════════
  // 本地开发时 wrangler dev 自动创建本地实例；
  // 生产部署时自动在 Cloudflare 上查找同名资源并绑定。
  // 如果 Cloudflare 控制台已手动配置同名绑定，会优先复用控制台配置，不会覆盖。
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "r2pan",
      "database_id": "13b24a37-6d2f-4807-a257-150d9bb9178f"
    }
  ],
  // ⚠️ R2 是可选的 —— 如果你改用其他 S3 兼容存储（见下方 analytics_engine_datasets），
  //    可以注释掉这个 r2_buckets 块，把存储完全交给外部 S3。
  "r2_buckets": [
    {
      "binding": "r2",
      "bucket_name": "r2pan"
    }
  ],

  // ═══════════════ Workers Analytics Engine（全球分布分析） ═══════════════
  // 每次下载都会向这个 dataset 写入一个数据点，包含国家、经纬度、文件名等。
  // 绑定是可选的：没绑定时全球分布 Tab 会降级使用 D1 的 download_logs。
  // 首次部署时 Cloudflare 会自动创建这个 dataset。
  "analytics_engine_datasets": [
    {
      "binding": "analytics",
      "dataset": "r2pan_downloads"
    }
  ],

  // ═══════════════ 密钥/敏感配置（不在仓库中声明） ═══════════════
  //
  //   ADMIN_EMAIL    邮箱验证码唯一白名单
  //   MAIL_FROM      验证码发件人
  //
  // 本地开发：在 .dev.vars 里写 admin=xxx（该文件已入库，不要放真实发信密钥）

  // 将 public/*.html 作为文本模块导入
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true },
    // 本地内置的地球贴图（全球分布地球仪使用）——作为二进制模块打进 Worker，
    // 通过 /assets/earth-day.jpg 同源提供，避免依赖外部 CDN（部分网络环境会加载失败，导致地球变白色球体）
    { "type": "Data", "globs": ["**/*.jpg"], "fallthrough": true },
    // 站点图标 —— 同样作为二进制模块打进 Worker，由 /favicon.ico 路由返回
    { "type": "Data", "globs": ["**/*.ico"], "fallthrough": true },
    // 站点图片（512x512）—— 由 /logo.png 路由返回
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ]
}
